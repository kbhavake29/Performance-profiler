{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Release (installed opentelemetry-cpp)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "IPP_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug with AddressSanitizer + UBSan",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer"
      }
    },
    {
      "name": "fetch",
      "displayName": "Release, building opentelemetry-cpp from source",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-fetch",
      "cacheVariables": {
        "IPP_FETCH_OPENTELEMETRY": "ON",
        "IPP_WARNINGS_AS_ERRORS": "OFF",
        "CMAKE_DISABLE_FIND_PACKAGE_opentelemetry-cpp": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "fetch", "configurePreset": "fetch" }
  ],
  "testPresets": [
    { "name": "default", "configurePreset": "default", "output": { "outputOnFailure": true } },
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "fetch", "configurePreset": "fetch", "output": { "outputOnFailure": true } }
  ]
}
