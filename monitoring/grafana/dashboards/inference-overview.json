      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(inference_request_duration_seconds_bucket{job=~\"$job\", gen_ai_request_model=~\"$model\", inference_runtime_version=~\"$runtime\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true,
          "exemplar": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
