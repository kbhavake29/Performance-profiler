          "expr": "histogram_quantile(0.95, sum by (le) (rate(inference_request_duration_seconds_bucket{job=~\"$job\", gen_ai_request_model=~\"$model\", inference_runtime_version=~\"$runtime\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true,
          "exemplar": true
